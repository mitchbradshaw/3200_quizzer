{
  "name": "mech3200-vibrations-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive study lab for MECH3200 Advanced Dynamics & Vibrations (UQ)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev --watch",
