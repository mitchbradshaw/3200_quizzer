    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.24.0",
    "playwright-core": "1.48.2",
    "typescript": "5.6.3"
  }
}
